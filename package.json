{
  "name": "@sienci/gviewer",
  "version": "0.1.17",
  "description": "GCode visualization library using Three.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/kglovern/gcode_parser_viewer"
  },
  "homepage": "https://github.com/kglovern/gcode_parser_viewer",
  "bugs": {
    "url": "https://github.com/kglovern/gcode_parser_viewer/issues"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "import": "./dist/gviewer.js",
      "require": "./dist/gviewer.cjs",
      "types": "./dist/types/index.d.ts"
    },
    "./viewer": {
      "import": "./dist/viewer.js",
      "require": "./dist/viewer.cjs",
      "types": "./dist/types/viewer/index.d.ts"
    },
    "./react": {
      "import": "./dist/react.js",
      "require": "./dist/react.cjs",
      "types": "./dist/types/react/index.d.ts"
    },
    "./viewer/viewcube.css": "./dist/viewcube.css"
  },
  "main": "./dist/gviewer.cjs",
  "module": "./dist/gviewer.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "vite build --watch",
    "demo": "vite --config vite.demo.config.ts",
    "build:demo": "vite build --config vite.demo.config.ts"
  },
  "dependencies": {
    "gsap": "^3.15.0"
  },
  "peerDependencies": {
    "three": "^0.168.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.168.0",
    "@vitejs/plugin-react": "^4.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "three": "^0.168.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
